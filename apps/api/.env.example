# ─────────────────────────────────────────────────────────────────────────────
# Fatanpur Bazaar — API environment (apps/api/.env)
# Har value boot pe Zod se check hoti hai (A1). Galat/khaali hone par app start
# NAHI hoga — chup-chaap default se chalna mana hai.
# Naye secrets banane ke liye:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
PORT=3000
APP_NAME=Fatanpur Bazaar

# Website ka URL (Next.js) aur API ka public URL — dono absolute
APP_URL=http://localhost:3001
API_URL=http://localhost:3000

# CORS allowlist — comma separated. ⚠️ '*' kabhi nahi (SECURITY_AUDIT §3)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006

# ── Database (MySQL 8 / MariaDB 10.4+) ───────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fatanpur
DB_USER=fatanpur
DB_PASSWORD=
# ⚠️ 2 apps × 8 = 16 connections < Hostinger ki 50 ki limit. Isse upar mat badhao.
DB_POOL_MIN=2
DB_POOL_MAX=8

# ── Secrets — teeno ALAG hone chahiye, har ek 32+ characters ─────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Production me cookie domain (optional), jaise: .fatanpurbazaar.com
COOKIE_DOMAIN=
# Reverse proxy ke peeche 1 (asli client IP X-Forwarded-For se)
TRUST_PROXY=1
# ⚠️ Website aur API ke beech ka "handshake" — DONO .env me BILKUL EK JAISA.
# Iske bina live dukaan me har grahak API ko website ke ek hi address se dikhta hai, aur sab
# ek hi rate-limit me phas jaate hain: 15 minute me 11va OTP sabke liye mana. Production me
# iske bina API chalu hi nahi hoti. Banaane ke liye:  openssl rand -hex 32
EDGE_SECRET=

# ── OTP / SMS ────────────────────────────────────────────────────────────────
# null     = dev mode (OTP app/storage/logs/otp-dev.log me likha jaata hai, response me KABHI nahi)
# fast2sms | msg91 = courier — code HUM banate hain, wo sirf pahunchate hain. Production me DLT
#                    approved template chahiye (approval me hafte lag sakte hain).
# minimoth = poora OTP unka — wo code banate hain, pehle WhatsApp se bhejte hain, na jaye to SMS,
#            aur verify bhi wahi karte hain. DLT ka intezaar nahi. ~Rs 0.35 per OTP.
#            ⚠️ Unka apna token hum istemaal NAHI karte — session hamesha hamara hi rehta hai.
#            Key minimoth.dev se milti hai.
# ⚠️ Ye sirf yahin (.env) se badalta hai — admin panel me otp_driver tala-band hai, taaki panel me
#    ghusa koi bhi aadmi login ka tareeka na badal sake. Badalne ke baad API restart karein.
# ⚠️ Production me `null` = KOI login nahi kar payega (code jaan-boojhkar mana karta hai).
SMS_DRIVER=null
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
MINIMOTH_API_KEY=

# Browser ke errors bhi storage/logs/problems.log me jaayen (testing ke liye).
# Khali chhoda to: development me ON, production me OFF.
CLIENT_ERROR_LOG=

# ── Push notifications ───────────────────────────────────────────────────────
# FCM service account JSON (mobile push) — poori JSON ek line me, ya file path
FIREBASE_SERVICE_ACCOUNT=
# Web Push VAPID keys — banane ke liye: node dist/cli.js vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fatanpurbazaar.com

# ── Maps (IMapProvider) ──────────────────────────────────────────────────────
# osm = MapLibre + OSM tiles (default, free). google = drop-in replacement
MAP_PROVIDER=osm
MAP_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Uploads + private prescriptions yahan jaate hain. ⚠️ webroot ke BAHAR rakho.
STORAGE_PATH=./storage
PUBLIC_UPLOAD_URL=/uploads
UPLOAD_MAX_MB=8

# ── Socket.IO ────────────────────────────────────────────────────────────────
SOCKET_PATH=/socket
SOCKET_TRANSPORTS=websocket,polling
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_HTTP_BUFFER=8192

# ── Misc ─────────────────────────────────────────────────────────────────────
# ⚠️ App aur DB dono +05:30 pe chalte hain
TZ=Asia/Kolkata
LOG_LEVEL=info
# Pehla ADMIN banane ke liye ek baar ka token (seed-admin CLI isko maangta hai).
# Admin ban jaane ke baad isko hata dena.
SETUP_TOKEN=
# CI deploy me git commit sha bhar deta hai (/health me dikhta hai)
GIT_COMMIT=dev
