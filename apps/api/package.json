{
  "name": "@fb/api",
  "version": "1.0.0",
  "private": true,
  "description": "Fatanpur Bazaar API — NestJS 11 modular monolith (REST + Socket.IO)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node -r dotenv/config --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" && tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "seed:admin": "node dist/cli.js seed-admin",
    "cron": "node dist/cli.js cron",
    "test:unit": "tsx --test test/unit/*.spec.ts",
    "test:int": "tsc -p tsconfig.spec.json && node scripts/copy-assets.mjs dist-spec/src && node --test --test-concurrency=1 dist-spec/test/integration/*.spec.js",
    "test": "npm run test:unit && npm run test:int",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@fb/shared-types": "1.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "knex": "^3.1.0",
    "lru-cache": "^11.1.0",
    "mysql2": "^3.14.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.33.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
