# Copy to `.env` before running `react-native run-android`. react-native-config reads this
# file at NATIVE BUILD time (Android Gradle plugin) — changing it needs a rebuild, not just reload.

# Host only, no path, no trailing slash. The API's global prefix (/v1) is appended in code.
# Emulator → your machine's dev server: http://10.0.2.2:3000  Real device on same Wi-Fi: http://<lan-ip>:3000
API_BASE_URL=http://10.0.2.2:3000

# Socket.IO connects to API_BASE_URL directly (no /v1 — the gateway is mounted at the path below,
# not under the HTTP prefix). Must match apps/api SOCKET_PATH (default /socket).
SOCKET_PATH=/socket

# Support / WhatsApp shown on the "sorry, out of area" screen and in Profile.
SUPPORT_PHONE=9616038670
