# Release signing — copy this to keystore.properties (git-ignored) and fill in.
#
# To generate the keystore:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore fatanpur-release.keystore \
#     -alias fatanpur -keyalg RSA -keysize 2048 -validity 10000
#
# Move fatanpur-release.keystore into android/app/ after generating it.
# Keep the keystore + passwords backed up — a lost signing key means the app
# can NEVER be updated on Play Store again.

FB_RELEASE_STORE_FILE=fatanpur-release.keystore
FB_RELEASE_KEY_ALIAS=fatanpur
FB_RELEASE_STORE_PASSWORD=<your-keystore-password>
FB_RELEASE_KEY_PASSWORD=<your-key-password>
