# ─────────────────────────────────────────────────────────────────────────────
# Fatanpur Bazaar — Website environment (apps/web/.env.local)
# ⚠️ NEXT_PUBLIC_* browser bundle me chala jaata hai — usme koi secret KABHI nahi.
# ─────────────────────────────────────────────────────────────────────────────

# Browser se API kis URL pe dikhti hai (socket + UPI QR isi se)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Website ka apna public URL (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Socket.IO path — API ke SOCKET_PATH se same hona chahiye
NEXT_PUBLIC_SOCKET_PATH=/socket

# Server-side (browser me nahi jaata): Next→API server-to-server call.
# Same machine pe ho to 127.0.0.1 rakho — ek network hop bachta hai.
API_INTERNAL_URL=http://127.0.0.1:3000

# Cookie domain (production), jaise: .fatanpurbazaar.com. Dev me khaali chhodein.
COOKIE_DOMAIN=

# ⚠️ API ke .env wala EDGE_SECRET — BILKUL wahi value. Server-only (NEXT_PUBLIC_ nahi!).
# Isse API har grahak ko uske apne address se pehchaanti hai, website ke address se nahi.
EDGE_SECRET=
# Website ke aage kitne proxy hain jo X-Forwarded-For me jodte hain. Hostinger par 1.
# CDN (jaise Cloudflare) bhi lagaya to 2.
EDGE_TRUSTED_HOPS=1

# Web Push (VAPID) ka public key — API ke `node dist/cli.js vapid` se milta hai.
# ⚠️ Sirf PUBLIC key yahan; private key sirf API ke .env me.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
